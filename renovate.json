{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableDependencyDashboard",
    ":automergeMinor",
    ":rebaseStalePrs"
  ],
  "ignorePresets": ["group:monorepos"],
  "automergeStrategy": "squash",
  "assignees": ["samtrion"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "prPriority": 20
  },
  "enabledManagers": ["custom.regex", "dockerfile", "github-actions", "nuget"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.cs$/"],
      "matchStrings": ["/\\*\\s*dockerimage\\s*\\*/\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "prPriority": 5,
      "labels": ["dependency:nuget"],
      "semanticCommitScope": "deps",
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["NetEvolve", "NetEvolve.*"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "prPriority": 10,
      "labels": ["dependency:actions"],
      "automerge": true,
      "semanticCommitScope": "ci"
    },
    {
      "matchDatasources": ["docker", "custom.regex"],
      "prPriority": -5,
      "labels": ["dependency:docker"],
      "semanticCommitScope": "docker",
      "versioning": "loose"
    },
    {
      "groupName": "Testcontainers packages",
      "groupSlug": "testcontainers-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Testcontainers", "Testcontainers.*"]
    },
    {
      "groupName": "TUnit packages",
      "groupSlug": "tunit-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["TUnit", "TUnit.*", "Verify.TUnit"]
    },
    {
      "groupName": "XUnit.V3 packages",
      "groupSlug": "xunit-v3-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["XUnit.V3", "XUnit.V3.*", "Verify.XunitV3"]
    },
    {
      "groupName": "MSTest packages",
      "groupSlug": "mstest-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["MSTest", "MSTest.*", "Verify.MSTest"]
    },
    {
      "groupName": "Microsoft Entity Framework",
      "groupSlug": "microsoft-entity-framework",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.EntityFrameworkCore", "Microsoft.EntityFrameworkCore.*"]
    },
    {
      "groupName": "OpenTelemetry Instrumentation packages",
      "groupSlug": "opentelemetry-instrumentation-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["OpenTelemetry.Instrumentation.*"]
    },
    {
      "groupName": "AWS SDK packages",
      "groupSlug": "aws-sdk-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["AWSSDK.*"]
    },
    {
      "groupName": "NetEvolve HttpCorrelation packages",
      "groupSlug": "netevolve-httpcorrelation-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["NetEvolve.Http.Correlation", "NetEvolve.Http.Correlation.*"]
    },
    {
      "groupName": "Microsoft.Extensions packages",
      "groupSlug": "microsoft-extensions-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\.Extensions\\./"]
    },
    {
      "groupName": "Roslynator packages",
      "groupSlug": "roslynator-packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Roslynator/"]
    }
  ]
}
